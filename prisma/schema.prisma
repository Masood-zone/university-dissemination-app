generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  DEPARTMENT_ADMIN
  LECTURER
  STUDENT
}

enum SemesterName {
  FIRST
  SECOND
}

enum AnnouncementCategory {
  OLD_AFFAIRS
  CURRENT_AFFAIRS
  DEPARTMENTAL
  ACADEMIC
  EVENT
  MAINTENANCE
  OTHER
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  ANNOUNCEMENT
  MESSAGE
  SYSTEM
  ACADEMIC
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationDocumentType {
  PASSPORT_PHOTO
  TRANSCRIPT
  CERTIFICATE
  ID_DOCUMENT
  BIRTH_CERTIFICATE
  OTHER
}

enum ProgrammeAwardType {
  UNDERGRADUATE
  POSTGRADUATE
  DIPLOMA
}

// ============================================================================
// AUTH (Better Auth) - MAINTAINED MODELS
// ============================================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // App user fields
  firstName    String
  lastName     String
  phone        String?
  role         Role    @default(STUDENT)
  isActive     Boolean @default(true)
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  avatar       String?
  lastLogin    DateTime?

  // Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  studentProfile         StudentProfile?
  lecturerProfile        LecturerProfile?
  departmentAdminProfile DepartmentAdminProfile?
  announcements          Announcement[]   @relation("CreatedBy")
  messages               Message[]        @relation("Sender")
  receivedMessages       Message[]        @relation("Recipient")
  notifications          Notification[]
  permissions            Permission[]
  lecturerAssignments    CourseAssignment[] @relation("LecturerAssignments")
  enrollments            Enrollment[]
  applications           Application[] @relation("Applicant")
  applicationStatusChanges ApplicationStatusHistory[] @relation("StatusChangedBy")
  roleTemplateAssignments UserRoleTemplate[]
  auditLogs              AuditLog[] @relation("AuditActor")
  mediaAssets            MediaAsset[]

  @@unique([email])
  @@index([departmentId])
  @@index([role])
  @@map("user")
}

model MediaAsset {
  id          String   @id @default(cuid())
  provider    String   @default("CLOUDINARY")
  publicId    String?
  url         String
  secureUrl   String?
  format      String?
  width       Int?
  height      Int?
  bytes       Int?
  folder      String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@index([provider])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================================
// CORE MODELS
// ============================================================================

model DepartmentAdminProfile {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  staffId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model StudentProfile {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  studentId       String   @unique
  batch           String
  gpa             Float?
  enrolledCourses String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([studentId])
}

model LecturerProfile {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  employeeId     String   @unique
  qualification  String
  specialization String
  office         String?
  officeHours    String?
  taughtCourses  String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([employeeId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  headOfDept  String?
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  programmes      Programme[]
  announcements   Announcement[]
  courses         Course[]
  courseOfferings CourseOffering[]
  applications    Application[]

  @@index([code])
}

model Programme {
  id            String   @id @default(cuid())
  name          String
  code          String
  description   String?
  awardType     ProgrammeAwardType @default(UNDERGRADUATE)
  durationYears Int?
  totalSemesters Int?
  minCredits    Int?
  isActive      Boolean  @default(true)
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courses      Course[]
  applications Application[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@index([isActive])
}

// ============================================================================
// ACADEMIC SESSIONS & OFFERINGS
// ============================================================================

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(false)
  currentSemester SemesterName?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]
  offerings CourseOffering[]
  applications Application[]

  @@index([isActive])
}

model Semester {
  id        String        @id @default(cuid())
  name      SemesterName
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]

  @@unique([sessionId, name])
  @@index([sessionId])
}

// ============================================================================
// ANNOUNCEMENTS & CONTENT
// ============================================================================

model Announcement {
  id               String               @id @default(cuid())
  title            String
  content          String
  excerpt          String?
  category         AnnouncementCategory
  status           AnnouncementStatus   @default(PUBLISHED)
  author           User                 @relation("CreatedBy", fields: [authorId], references: [id])
  authorId         String
  department       Department?          @relation(fields: [departmentId], references: [id])
  departmentId     String?
  courseOffering   CourseOffering?      @relation(fields: [courseOfferingId], references: [id], onDelete: SetNull)
  courseOfferingId String?
  imageUrl         String?
  priority         Int                  @default(0)
  viewCount        Int                  @default(0)
  pinned           Boolean              @default(false)
  publishedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  notifications Notification[]

  @@index([authorId])
  @@index([departmentId])
  @@index([courseOfferingId])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
}

// ============================================================================
// ACADEMIC INFORMATION
// ============================================================================

model Course {
  id            String     @id @default(cuid())
  code          String
  title         String
  description   String?
  credits       Int
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String
  programme     Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  programmeId   String?
  semester      Int
  capacity      Int?
  level         Int?
  prerequisites String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offerings CourseOffering[]

  @@unique([code, departmentId])
  @@index([departmentId])
  @@index([programmeId])
}

// ============================================================================
// ADMISSIONS & APPLICATIONS
// ============================================================================

model Application {
  id                 String            @id @default(cuid())
  applicationNo      String            @unique
  status             ApplicationStatus @default(DRAFT)
  applicantFirstName String
  applicantLastName  String
  applicantEmail     String
  applicantPhone     String?
  applicant          User?             @relation("Applicant", fields: [applicantId], references: [id], onDelete: SetNull)
  applicantId        String?
  department         Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId       String
  programme          Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  programmeId        String
  session            AcademicSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId          String?
  notes              String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  decidedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  documents     ApplicationDocument[]
  statusHistory ApplicationStatusHistory[]

  @@index([status])
  @@index([applicantId])
  @@index([departmentId])
  @@index([programmeId])
  @@index([sessionId])
  @@index([submittedAt])
}

model ApplicationDocument {
  id          String                  @id @default(cuid())
  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type        ApplicationDocumentType
  fileName    String
  fileUrl     String
  mimeType    String?
  sizeBytes   Int?
  isVerified  Boolean                 @default(false)
  verifiedAt  DateTime?
  uploadedAt  DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([applicationId])
  @@index([type])
  @@index([isVerified])
}

model ApplicationStatusHistory {
  id          String            @id @default(cuid())
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus
  changedBy   User?             @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedById String?
  note        String?
  createdAt   DateTime          @default(now())

  @@index([applicationId])
  @@index([changedById])
  @@index([createdAt])
}

model CourseOffering {
  id           String          @id @default(cuid())
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String
  semester     Semester        @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId   String
  isActive     Boolean         @default(true)
  capacity     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments      CourseAssignment[]
  enrollments      Enrollment[]
  timetableEntries Timetable[]
  exams            Exam[]
  announcements    Announcement[]

  @@unique([courseId, sessionId, semesterId])
  @@index([courseId])
  @@index([departmentId])
  @@index([sessionId])
  @@index([semesterId])
}

model CourseAssignment {
  id         String         @id @default(cuid())
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String
  lecturer   User           @relation("LecturerAssignments", fields: [lecturerId], references: [id], onDelete: Cascade)
  lecturerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timetableEntries Timetable[]

  @@unique([offeringId, lecturerId])
  @@index([offeringId])
  @@index([lecturerId])
}

model Enrollment {
  id         String         @id @default(cuid())
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([offeringId, studentId])
  @@index([offeringId])
  @@index([studentId])
}

model Timetable {
  id           String           @id @default(cuid())
  offering     CourseOffering?  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId   String?
  assignment   CourseAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId String?
  dayOfWeek    Int
  startTime    String
  endTime      String
  location     String
  lecturer     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([offeringId])
  @@index([assignmentId])
}

model Exam {
  id         String         @id @default(cuid())
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String
  examType   String
  examDate   DateTime
  startTime  String
  endTime    String
  location   String
  totalMarks Int
  duration   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([offeringId])
  @@index([examDate])
}

model AcademicCalendar {
  id           String   @id @default(cuid())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  type         String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([academicYear])
  @@index([type])
}

// ============================================================================
// MESSAGING & NOTIFICATIONS
// ============================================================================

model Message {
  id          String        @id @default(cuid())
  sender      User          @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  recipient   User          @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  content     String
  status      MessageStatus @default(SENT)
  attachments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  announcement   Announcement?    @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  announcementId String?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// ============================================================================
// RBAC - PERMISSIONS
// ============================================================================

model RoleTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  role        Role
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RoleTemplatePermission[]
  assignments UserRoleTemplate[]

  @@index([role])
}

model RoleTemplatePermission {
  id          String       @id @default(cuid())
  template    RoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  action      String
  resource    String
  granted     Boolean      @default(true)

  @@unique([templateId, action, resource])
  @@index([templateId])
}

model UserRoleTemplate {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  template   RoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  isPrimary  Boolean      @default(true)
  assignedAt DateTime     @default(now())

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
}

model Permission {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  action   String
  resource String
  granted  Boolean @default(true)

  @@unique([userId, action, resource])
  @@index([userId])
}
